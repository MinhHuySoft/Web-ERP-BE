{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "WebErp": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "WebErp": {
    "Root": "C:/WebErp",
    "AppName": "ERP Web",
    "RequireHttps": true,
    "TimeZone": "Asia/Ho_Chi_Minh",
    "Session": {
      "IdleMinutes": 60,
      "MaxHours": 12,
      "UserCheckSeconds": 60,
      "MenuCacheMinutes": 5
    },
    "Login": {
      "MaxFailures": 5,
      "LockMinutes": 5
    },
    "Erp": {
      "CommandTimeoutSeconds": 30,
      "ConnectTimeoutSeconds": 15
    },
    "Forwarded": {
      "Enabled": false,
      "KnownProxies": []
    }
  }
}
