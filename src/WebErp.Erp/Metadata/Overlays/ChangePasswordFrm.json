// Đổi mật khẩu / thông tin người dùng. Nguồn: Tools.Sys/ChangePasswordFrm.cs:396-504.
// Chỉ đọc thông tin của chính người đang đăng nhập; KHÔNG lấy cột Password. Đổi mật mã thuộc mốc ghi dữ liệu.
{
  "form": "ChangePasswordFrm",
  "formType": "DIALOG",
  "caption": "Đổi mật khẩu",
  "useDbConfig": false,
  "cfg": {
    "SPA2": "1",
    "SPA3": "1",
    "WNOTE": "Thông tin người dùng đang đăng nhập và màn hình khởi động. Đổi mật mã sẽ dùng được khi web có chức năng ghi dữ liệu.",
    "WACT": "Đổi mật mã;Áp dụng",
    "T0": {
      "TN": "SY_User",
      "PK": "UserName",
      "SE": "SY_User.UserName, SY_User.HoTen, SY_User.StartupForm",
      "EX": "(SELECT TOP 1 M.VN FROM {Mod}_Menu M WHERE M.FormName = SY_User.StartupForm ORDER BY M.MenuID) AS StartupFormName",
      "FTW": "SY_User.UserName = {User}",
      "TRS": "1"
    },
    "F0": {
      "UserName": "Tên đăng nhập",
      "HoTen": "Tên đầy đủ",
      "StartupForm": "Màn hình khởi động",
      "StartupFormName": "Tên màn hình khởi động"
    }
  }
}
