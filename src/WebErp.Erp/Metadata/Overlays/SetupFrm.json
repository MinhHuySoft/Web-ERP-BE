// Thiết lập thông số hệ thống. Nguồn: Sys/SetupFrm.cs:2596-2712 (đọc), resx Layout1..5 (cột).
// Gần đúng: tham số SY_Setup thành một lưới gom theo nhóm; các lưới khác là tab độc lập (IND).
// Giá trị liên kết DB / máy chủ (LinkDatabase, LinkServer*) và mọi tham số kiểu mật khẩu/khóa: BE không trả giá trị.
// Web không chạy ~27 INSERT SY_Setup mặc định lúc mở form.
{
  "form": "SetupFrm",
  "formType": "LIST",
  "caption": "Thiết lập thông số hệ thống",
  "useDbConfig": false,
  "cfg": {
    "SPA2": "1",
    "WACT": "Lưu;Không lưu",
    "T0": {
      "TN": "SY_Setup",
      "PK": "CodeID",
      "SE": "SY_Setup.CodeID, SY_Setup.CodeName, CASE WHEN SY_Setup.CodeID LIKE 'Link%' OR SY_Setup.CodeID LIKE '%pass%' OR SY_Setup.CodeID LIKE '%pwd%' OR SY_Setup.CodeID LIKE '%token%' OR SY_Setup.CodeID LIKE '%key%' OR SY_Setup.CodeID LIKE '%secret%' OR SY_Setup.CodeID LIKE '%conn%' THEN N'(ẩn)' ELSE SY_Setup.CodeValue END AS CodeValue, CASE WHEN SY_Setup.CodeID LIKE 'Link%' OR SY_Setup.CodeID LIKE '%pass%' OR SY_Setup.CodeID LIKE '%pwd%' OR SY_Setup.CodeID LIKE '%token%' OR SY_Setup.CodeID LIKE '%key%' OR SY_Setup.CodeID LIKE '%secret%' OR SY_Setup.CodeID LIKE '%conn%' THEN N'(ẩn)' ELSE SY_Setup.CodeValue2 END AS CodeValue2, SY_Setup.GroupID, SY_Setup.IndexID",
      "SO": "SY_Setup.GroupID, SY_Setup.IndexID, SY_Setup.CodeID",
      "GCA": "GroupID",
      "HDE": "IndexID",
      "GD2": "GroupID;CodeID;CodeName;CodeValue;CodeValue2"
    },
    "F0": {
      "CodeID": "Mã",
      "CodeName": "Tham số",
      "CodeValue": "Giá trị",
